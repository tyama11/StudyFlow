{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyFlow",
  "version": "2.0.0",
  "identifier": "com.studyflow.tracker",
  "build": {
    "beforeDevCommand": "pnpm run build",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StudyFlow - \u5b66\u7fd2\u6642\u9593\u8a18\u9332 & TODO\u30a2\u30d7\u30ea",
        "width": 1100,
        "height": 780,
        "minWidth": 850,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
