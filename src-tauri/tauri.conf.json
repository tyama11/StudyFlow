{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "study-flow",
  "version": "1.1.0",
  "identifier": "com.studyflow.tracker",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StudyFlow - 学習時間記録 & TODOアプリ",
        "width": 1100,
        "height": 780,
        "minWidth": 850,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
