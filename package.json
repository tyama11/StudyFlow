{
  "name": "studyflow",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsrs --noEmit --fast && vite build",
    "build:desktop": "tsrs --noEmit --fast && vite build",
    "build:pages": "tsrs --noEmit --fast && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "type-check": "tsrs --noEmit --fast",
    "lint": "TSRS_FAST=1 oxlint --type-aware --type-check --deny-warnings src tests",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "tsrs": "7.1.0-beta.tsrs5",
    "oxlint": "1.95.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.4.8"
  }
}
