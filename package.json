{
  "name": "studyflow",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "*",
    "@tauri-apps/cli": "*",
    "@vitest/coverage-v8": "*",
    "eslint": "*",
    "typescript": "*",
    "typescript-eslint": "*",
    "vite": "*",
    "vitest": "*"
  },
  "dependencies": {
    "@tauri-apps/api": "*"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    }
  }
}
